# All optional.

# Claude-powered answers in the advisor. Without it the built-in advisor is used.
ANTHROPIC_API_KEY=

# Use a different Firebase project for sign-in. Without these, the project
# baked into src/lib/firebase.js is used.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
